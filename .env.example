# ---------------------------------------------------------------- LLM
# Cualquier proveedor de init_chat_model ("proveedor:modelo")
# Opción A – Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=google_genai:gemini-3.5-flash-lite
LLM_RPM=8            # límite de peticiones/min (compartido por todos los jobs del worker)
# Opción B – Claude
# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic:claude-opus-5-5

# Opcional: búsqueda web real para el investigador
TAVILY_API_KEY=

# Límites anti "supervisor infinito"
MAX_STEPS=8
MAX_REVISIONS=2

# ---------------------------------------------------------------- Redis
# Redis 8 (o Redis Stack): RedisSaver necesita los módulos JSON + Search.
# Con docker compose el host es "redis"; fuera de Docker, localhost:6380 (puerto publicado).
REDIS_URL=redis://localhost:6380/0
CHECKPOINT_TTL_MIN=10080   # TTL de los checkpoints de LangGraph (7 días)

# ---------------------------------------------------------------- Worker / API
WORKER_MODE=external       # external = proceso `python -m app.worker` · inline = dentro de la API
WORKER_CONCURRENCY=5       # jobs simultáneos por worker
JOB_TIMEOUT_S=900          # pasado este tiempo el job pasa a FAILED
REPORTS_DIR=reports        # dónde escribe la herramienta publish_report

# ---------------------------------------------------------------- Human-in-the-loop
HITL_TOKEN_THRESHOLD=60000 # ejecuciones que superan estos tokens requieren aprobación

# ---------------------------------------------------------------- Observabilidad
# Arize Phoenix (por defecto; UI en http://localhost:6006)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=pre7-multiagente
# LangSmith (alternativa): deja vacío PHOENIX_COLLECTOR_ENDPOINT y rellena esto
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pre7-multiagente
