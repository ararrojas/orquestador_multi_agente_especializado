# LLM (cualquier proveedor soportado por init_chat_model: "proveedor:modelo")
# Opción A – Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=google_genai:gemini-3.5-flash-lite
LLM_RPM=8            # límite de peticiones/min para no superar la cuota gratuita
# Opción B – Claude
# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic:claude-opus-5-5

# Opcional: si está definida, el investigador también busca en la web con Tavily
TAVILY_API_KEY=

# Límites anti "supervisor infinito"
MAX_STEPS=8
MAX_REVISIONS=2
